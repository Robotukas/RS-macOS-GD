#ifndef GDHubVirtualHID_h
#define GDHubVirtualHID_h
#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
class IOUserClient;
class GDHubVirtualHID : public IOService {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService * provider) override;   // Start(SUPERDISPATCH) then RegisterService()
    virtual kern_return_t Stop(IOService * provider) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient ** userClient) override;
    // RPC (no LOCAL, no LOCALONLY): dispatched onto this service's default queue. Called by the owning user client
    // (rank 1 -> rank 2). `ownerGen` is the generation GDHubClaimOwner returned; a stale one is refused.
    virtual kern_return_t CreatePad(uint64_t ownerGen);
    virtual kern_return_t DestroyPad(uint64_t ownerGen);
    // T7: the 30 s orphan timer (a pinned pad whose owner left). Runs on this service's default queue.
    virtual void OrphanFired(OSAction * action TARGET, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);
};
#endif
