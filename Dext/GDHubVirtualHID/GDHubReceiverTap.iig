#ifndef GDHubReceiverTap_h
#define GDHubReceiverTap_h
#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <HIDDriverKit/IOHIDInterface.iig>
// The receiver tap (receiver-takeover plan T4). A plain IOService that matches interface 3's IOHIDInterface only
// (IOProbeScore 1000) and, only when an owner has asked for COUNT, opens it and counts the reports. T4 translates and posts
// nothing. It runs on its own default queue (rank 3): Start, Stop, SetPowerState, the 50 ms timer, every ReportAvailable
// and the DispatchAsync pokes. It calls no GDHub object and nothing calls it synchronously.
class GDHubReceiverTap : public IOService {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
    virtual kern_return_t SetPowerState(uint32_t powerFlags) override;
    // Same declaration as IOUserHIDEventService::ReportAvailable and as the T0 probe (IOHIDInterface.iig:110-115).
    virtual void ReportAvailable(uint64_t timestamp,
                                 uint32_t reportID,
                                 uint32_t reportLength,
                                 IOHIDReportType type,
                                 IOMemoryDescriptor * report,
                                 OSAction * action) LOCAL
                                 TYPE(IOHIDInterface::ReportAvailable);
    virtual void TapTick(OSAction * action TARGET, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);
};
#endif
