#ifndef GDHubProbeTap_h
#define GDHubProbeTap_h
#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <HIDDriverKit/IOHIDInterface.iig>
// T0 probe tap: matches interface 3's IOHIDInterface (IOProbeScore 50), declines its first Start in a process, then
// opens the interface and measures. One serial queue (the default queue) runs Start, Stop, SetPowerState, the timer and
// every ReportAvailable, so the ivars need no locks.
class GDHubProbeTap : public IOService {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
    virtual kern_return_t SetPowerState(uint32_t powerFlags) override;
    // Same declaration as IOUserHIDEventService::ReportAvailable (HIDDriverKit IOUserHIDEventService.iig).
    virtual void ReportAvailable(uint64_t timestamp,
                                 uint32_t reportID,
                                 uint32_t reportLength,
                                 IOHIDReportType type,
                                 IOMemoryDescriptor * report,
                                 OSAction * action) LOCAL
                                 TYPE(IOHIDInterface::ReportAvailable);
    virtual void ProbeTick(OSAction * action TARGET, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);
};
#endif
